{
  "id": "/jft-nihongo/app.html",
  "name": "NihongoGo: Belajar Jepang untuk Kerja di Jepang",
  "short_name": "NihongoGo",
  "description": "Aplikasi belajar bahasa Jepang untuk kamu yang ingin bekerja di Jepang: persiapan ujian JFT-Basic, kosakata, tata bahasa, dan bahasa Jepang untuk dunia kerja.",
